{
  "name": "knitto-react-template",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release": "release-it",
    "lint": "eslint --fix",
    "format:all": "prettier --write \"**/*.+(js|mjs|cjs|jsx|ts|tsx|css|scss|json|yml|yaml)\" --ignore-path .gitignore --ignore-path .prettierignore",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "knittotextile",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.34.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@knittotextile/react-ui": "^2.1.7",
    "@loadable/component": "^5.16.7",
    "@reduxjs/toolkit": "^1.9.7",
    "@tanstack/react-virtual": "^3.13.18",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "js-cookie": "^3.0.5",
    "react": "^18.3.1",
    "react-calendar": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.30.3",
    "react-to-print": "^2.15.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "redux": "^4.2.1",
    "use-context-selector": "^2.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@release-it/conventional-changelog": "^5.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/js-cookie": "^3.0.6",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "msw": "^2.12.8",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "release-it": "^15.11.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.4"
  },
  "release-it": {
    "git": {
      "requireBranch": "release",
      "commitMessage": "chore: release v${version}",
      "requireCommits": true,
      "requireCleanWorkingDir": false,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "releaseName": "V ${version}"
    },
    "hooks": {
      "before:init": [
        "pnpm format:all",
        "pnpm lint"
      ],
      "after:bump": "npx auto-changelog -p"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  },
  "lint-staged": {
    "*/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ],
    "*/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
