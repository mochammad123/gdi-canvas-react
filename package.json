{
  "name": "knitto-react-template",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release": "release-it",
    "lint": "eslint --fix",
    "format:all": "prettier --write \"**/*.+(js|mjs|cjs|jsx|ts|tsx|css|scss|json|yml|yaml)\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "author": "knittotextile",
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@knittotextile/react-ui": "^1.0.0",
    "@loadable/component": "^5.16.7",
    "@reduxjs/toolkit": "^1.9.7",
    "@tanstack/react-virtual": "^3.13.18",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "js-cookie": "^3.0.5",
    "react": "^18.3.1",
    "react-calendar": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.30.3",
    "react-to-print": "^2.15.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "redux": "^4.2.1",
    "use-context-selector": "^2.0.0",
    "vite-plugin-pwa": "^0.16.7",
    "workbox-window": "^7.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@prefresh/vite": "^2.4.11",
    "@release-it/conventional-changelog": "^5.1.1",
    "@types/js-cookie": "^3.0.6",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^20.19.30",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "release-it": "^15.11.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.18"
  },
  "release-it": {
    "git": {
      "requireBranch": "release",
      "commitMessage": "chore: release v${version}",
      "requireCommits": true,
      "requireCleanWorkingDir": false,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "releaseName": "V ${version}"
    },
    "hooks": {
      "before:init": [
        "pnpm format:all",
        "pnpm lint"
      ],
      "after:bump": "npx auto-changelog -p"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  },
  "lint-staged": {
    "*/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ],
    "*/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.3+sha512.a4051aac4d6e1acacf30373196b02a207fc7b2c016570c54c139e90e1e24c70f1b90a3480f67ae0867b4f1d20f2d6e38695f6ba85c6e8394357b6f3058ec1e9c"
}
