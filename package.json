{
  "name": "knitto-react-template",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "release": "release-it",
    "lint": "eslint --fix",
    "format:all": "prettier --write \"**/*.+(js|mjs|cjs|jsx|ts|tsx|css|scss|json|yml|yaml)\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "author": "knittotextile",
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@loadable/component": "^5.16.3",
    "@reduxjs/toolkit": "^1.9.7",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.10",
    "js-cookie": "^3.0.5",
    "react": "^18.2.0",
    "react-calendar": "^5.0.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.52.1",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.22.3",
    "react-to-print": "^2.15.1",
    "redux": "^4.2.1",
    "vite-plugin-pwa": "^0.16.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prefresh/vite": "^2.4.5",
    "@release-it/conventional-changelog": "^5.1.1",
    "@types/js-cookie": "^3.0.6",
    "@types/loadable__component": "^5.13.9",
    "@types/node": "^20.12.5",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "husky": "^9.0.11",
    "postcss": "^8.4.40",
    "release-it": "^15.11.0",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "release-it": {
    "git": {
      "requireBranch": "release",
      "commitMessage": "chore: release v${version}",
      "requireCommits": true,
      "requireCleanWorkingDir": false,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "releaseName": "V ${version}"
    },
    "hooks": {
      "before:init": [
        "pnpm format:all",
        "pnpm lint"
      ],
      "after:bump": "npx auto-changelog -p"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  },
  "packageManager": "pnpm@9.0.6+sha512.f6d863130973207cb7a336d6b439a242a26ac8068077df530d6a86069419853dc1ffe64029ec594a9c505a3a410d19643c870aba6776330f5cfddcf10a9c1617"
}
